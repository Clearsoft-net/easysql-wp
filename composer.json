{
  "name": "clearsoft/easysql-wp",
  "description": "WordPress plugin for EasySQL – run queries, manage data, and build reports seamlessly.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "authors": [
    {
      "name": "Clearsoft",
      "homepage": "https://clearsoft.net"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../easysql-sdk-php/"
    },
    {
      "type": "vcs",
      "url": "https://github.com/Clearsoft-net/easysql-sdk-php.git"
    }
  ],
  "require": {
    "php": ">=7.4",
    "easysql/sdk": "0.1.0"
  },
    "autoload": {
        "psr-4": {
            "EasySQL\\": "src/",
            "EasySQL\\Tests\\": "tests/"
        }
    },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-plugin": {
      "name": "EasySQL",
      "plugin-file": "easysql-wp.php"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^13.2",
    "squizlabs/php_codesniffer": "*",
    "wp-coding-standards/wpcs": "*"
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress src/ easysql-wp.php uninstall.php",
    "lint:fix": "phpcbf --standard=WordPress src/ easysql-wp.php uninstall.php",
    "test": "phpunit"
  }
}
