{
  "name": "clearsoft/easysql-wp",
  "description": "Official WordPress plugin for EasySQL — Natural-language to SQL directly inside your WordPress dashboard.",
  "type": "wordpress-plugin",
  "license": "MIT",
  "homepage": "https://easysql.net",
  "keywords": [
    "wordpress",
    "wordpress-plugin",
    "easysql",
    "clearsoft",
    "sql",
    "ai",
    "llm",
    "database",
    "dashboard"
  ],
  "support": {
    "issues": "https://github.com/Clearsoft-net/easysql-wp/issues",
    "source": "https://github.com/Clearsoft-net/easysql-wp"
  },
  "authors": [
    {
      "name": "Clearsoft",
      "email": "contact@clearsoft.net",
      "homepage": "https://clearsoft.net"
    }
  ],
  "repositories": [
    {
      "type": "path",
      "url": "../sdk-php/",
      "options": {
        "symlink": false
      }
    }
  ],
  "require": {
    "php": ">=8.2",
    "clearsoft/easysql-sdk": "^1.5.0"
  },
  "autoload": {
    "psr-4": {
      "EasySQL\\": "src/",
      "EasySQL\\Tests\\": "tests/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "extra": {
    "wordpress-plugin": {
      "name": "EasySQL",
      "plugin-file": "easysql-wp.php"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0 || ^12.0 || ^13.0",
    "squizlabs/php_codesniffer": "*",
    "wp-coding-standards/wpcs": "*"
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress src/ easysql-wp.php uninstall.php",
    "lint:fix": "phpcbf --standard=WordPress src/ easysql-wp.php uninstall.php",
    "test": "phpunit"
  }
}
